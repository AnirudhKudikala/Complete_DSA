   "source": [
    "import heapq\n",
    "\n",
    "max_heap=[]\n",
    "\n",
    "nums=[5,8,1,10]\n",
    "\n",
    "for x in nums:\n",
    "    heapq.heappush(max_heap,-x)\n",
    "\n",
    "print(max_heap)\n",
    "\n",
    "largest = -heapq.heappop(max_heap)\n",
    "\n",
    "print(largest)"
   ]
  }
 ],
