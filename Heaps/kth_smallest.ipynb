   "source": [
    "import heapq\n",
    "\n",
    "nums = [10,3,5,8,2,11]\n",
    "\n",
    "k = 3\n",
    "\n",
    "max_heap=[]\n",
    "\n",
    "for i in nums:\n",
    "    heapq.heappush(max_heap, -i)\n",
    "    if len(max_heap)>k:\n",
    "        heapq.heappop(max_heap)\n",
    "res=[-x for x in max_heap]\n",
    "print(res)\n",
    "print(res[0])"
   ]
  }
 ],
